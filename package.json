{
  "name": "aca-schedule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:server-algorithm && npm run build:server-progress && tsc -b && vite build",
    "build:server-algorithm": "esbuild src/utils/autoSchedule.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/_lib/autoScheduleAlgorithm.js",
    "build:server-progress": "esbuild src/utils/stakeholderSchedule.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/_lib/stakeholderScheduleAlgorithm.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "tailwind:init": "tailwindcss init -p",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node tests/api/suite.cjs",
    "test:api:events": "node --test tests/api/event-copy.check.mjs tests/api/event-management.check.mjs",
    "test:api:quick": "node tests/api/quick.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/functions": "^3.9.11",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.35.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.8"
  }
}

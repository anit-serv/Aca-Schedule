rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー関数
    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isEventOwner(eventId) {
      return request.auth != null && eventData(eventId).ownerId == request.auth.uid;
    }

    // 承認済み共同編集者かどうかを確認
    function isEventCollaborator(eventId) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in eventData(eventId).collaboratorEmails;
    }

    // 招待中（未承認）の共同編集者かどうかを確認
    function isEventPendingCollaborator(eventId) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in eventData(eventId).pendingCollaboratorEmails;
    }

    // オーナーまたは承認済み共同編集者
    function isEventOwnerOrCollaborator(eventId) {
      return isEventOwner(eventId) || isEventCollaborator(eventId);
    }

    // ユーザー情報: 本人のみ読み書き可能
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 仮登録情報: クライアントSDKからの直接アクセスは禁止（Server APIのみ使用）
    match /registrationPendings/{pendingId} {
      allow read, write: if false;
    }

    // 関係者用パスワードのハッシュはサーバーAPIだけが参照する
    match /viewerPasswords/{eventId} {
      allow read, write: if false;
    }

    // 現場進行の実績と見込みは関係者パスワードを検証するAPIからのみ操作する
    match /stakeholderProgress/{eventId} {
      allow read, write: if false;
    }

    // イベント
    // - オーナーのみ読み書き可能
    // - 承認済み共同編集者は読み取り可能
    // - 招待中の共同編集者も読み取り可能（ホームで表示するため）
    // - 一般公開・関係者向けの読み取りはサーバーAPIで必要な項目だけ返す
    match /events/{eventId} {
      allow read: if (request.auth != null && resource.data.ownerId == request.auth.uid)
                   || (request.auth != null
                       && request.auth.token.email != null
                       && request.auth.token.email in resource.data.collaboratorEmails)
                   || (request.auth != null
                       && request.auth.token.email != null
                       && request.auth.token.email in resource.data.pendingCollaboratorEmails);
      allow create: if request.auth != null
                     && request.resource.data.ownerId == request.auth.uid;
      // オーナーは全フィールド更新可能
      // 承認済み共同編集者は自分のメールを collaboratorEmails から削除のみ可能（辞退）
      // 招待中の共同編集者は承認（pending→collaborator移動）または辞退（pending削除）が可能
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid)
                     || (request.auth != null
                         && request.auth.token.email != null
                         && request.auth.token.email in resource.data.collaboratorEmails
                         && !(request.auth.token.email in request.resource.data.collaboratorEmails)
                         && request.resource.data.ownerId == resource.data.ownerId
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorEmails', 'updatedAt']))
                     || (request.auth != null
                         && request.auth.token.email != null
                         && request.auth.token.email in resource.data.pendingCollaboratorEmails
                         && !(request.auth.token.email in request.resource.data.pendingCollaboratorEmails)
                         && request.resource.data.ownerId == resource.data.ownerId
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingCollaboratorEmails', 'collaboratorEmails', 'updatedAt']))
                     // オーナー権限移譲の承認（pendingOwnerEmail の対象者が実行）
                     || (request.auth != null
                         && request.auth.token.email != null
                         && request.auth.token.email == resource.data.pendingOwnerEmail
                         && request.resource.data.ownerId == request.auth.uid
                         && request.resource.data.pendingOwnerEmail == ''
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'collaboratorEmails', 'pendingOwnerEmail', 'transferFromOwnerEmail', 'updatedAt']))
                     // オーナー権限移譲の辞退（pendingOwnerEmail の対象者が実行）
                     || (request.auth != null
                         && request.auth.token.email != null
                         && request.auth.token.email == resource.data.pendingOwnerEmail
                         && request.resource.data.ownerId == resource.data.ownerId
                         && request.resource.data.pendingOwnerEmail == ''
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingOwnerEmail', 'updatedAt']))
                     // 承認済み共同編集者はカスタムフィールド・カスタムイベントのみ更新可能
                     || (request.auth != null
                         && request.auth.token.email != null
                         && request.auth.token.email in resource.data.collaboratorEmails
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customFields', 'customEvents', 'updatedAt']));
      allow delete: if request.auth != null
                     && resource.data.ownerId == request.auth.uid;
    }

    // バンド
    // - 関連するイベントのオーナーまたは承認済み共同編集者が読み書き可能
    // - 閲覧ページはサーバーAPIを経由する
    match /bands/{bandId} {
      allow read: if isEventOwnerOrCollaborator(resource.data.eventId);
      allow create: if isEventOwnerOrCollaborator(request.resource.data.eventId);
      allow update, delete: if isEventOwnerOrCollaborator(resource.data.eventId);
    }

    // タイムテーブル
    // - 関連するイベントのオーナーまたは承認済み共同編集者が読み書き可能
    // - 閲覧ページはサーバーAPIを経由する
    match /timetables/{timetableId} {
      allow read: if isEventOwnerOrCollaborator(resource.data.eventId);
      allow create: if isEventOwnerOrCollaborator(request.resource.data.eventId);
      // The server writes through the Admin SDK. Prevent stale editor tabs from
      // immediately replacing a validated automatic placement with recalculated times.
      allow update, delete: if isEventOwnerOrCollaborator(resource.data.eventId)
        && (!('autoScheduleProtectedUntil' in resource.data)
          || request.time >= resource.data.autoScheduleProtectedUntil);
    }

  }
}
